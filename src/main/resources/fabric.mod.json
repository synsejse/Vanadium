{
  "schemaVersion": 1,
  "id": "vanadium",
  "version": "${version}",
  "name": "Vanadium",
  "description": "A multi-threading mod for Minecraft, based on MCMT.",
  "authors": [
    "SynseNetwork"
  ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/synsejse/Vanadium"
  },
  "license": "GPLv3",
  "icon": "assets/vanadium/vanadium.png",
  "environment": "*",
  "entrypoints": {
    "preLaunch": [
      "com.synsenetwork.vanadium.launch.FastUtilPreloader"
    ],
    "main": [
      "com.synsenetwork.vanadium.Vanadium"
    ],
    "mixinsquared": [
      "com.synsenetwork.vanadium.mixin.utils.VanadiumMixinCanceller"
    ]
  },
  "accessWidener": "vanadium.accesswidener",
  "mixins": [
    "vanadium.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.11.3",
    "fabric": "*",
    "minecraft": "1.21.x",
    "java": ">=21",
    "cloth-config2": ">=5.0.34"
  },
  "suggests": {
  }
}
