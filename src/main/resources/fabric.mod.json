{
  "schemaVersion": 1,
  "id": "vanadium",
  "version": "${version}",
  "name": "Vanadium",
  "description": "Parallel server ticking for Minecraft. Put more of your CPU to work.",
  "authors": [
    "SynseNetwork"
  ],
  "contact": {
    "homepage": "https://github.com/synsejse/Vanadium",
    "sources": "https://github.com/synsejse/Vanadium"
  },
  "license": "GPLv3",
  "icon": "assets/vanadium/vanadium.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.synsenetwork.vanadium.Vanadium"
      }
    ],
    "mixinsquared": [
      "com.synsenetwork.vanadium.compat.C2ME"
    ]
  },
  "accessWidener": "vanadium.accesswidener",
  "mixins": [
    "vanadium.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-language-kotlin": ">=1.14.2+kotlin.2.4.21",
    "fabric-api": ">=0.165.2",
    "minecraft": "26.3",
    "java": ">=25",
    "cloth-config2": ">=26.3.159",
    "c2me": ">=0.4.2-alpha.0.116"
  },
  "suggests": {},
  "breaks": {
    "lithium": "<0.26.3",
    "vmp": "*"
  },
  "custom": {
    "lithium:options": {
      "mixin.world.chunk_access": false,
      "mixin.entity.inactive_navigations": false,
      "mixin.chunk.entity_class_groups": false,
      "mixin.collections.entity_filtering": false,
      "mixin.collections.entity_by_type": false,
      "mixin.collections.entity_ticking": false,
      "mixin.entity.fast_retrieval": false,
      "mixin.profiler": false
    }
  }
}
