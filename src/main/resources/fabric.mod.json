{
  "schemaVersion": 1,
  "id": "vanadium",
  "version": "${version}",
  "name": "Vanadium",
  "description": "A multi-threading mod for Minecraft, based on MCMT.",
  "authors": [
    "SynseNetwork"
  ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/synsejse/Vanadium"
  },
  "license": "GPLv3",
  "icon": "assets/vanadium/vanadium.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.synsenetwork.vanadium.Vanadium"
      }
    ],
    "mixinsquared": [
      "com.synsenetwork.vanadium.compat.C2ME"
    ]
  },
  "accessWidener": "vanadium.accesswidener",
  "mixins": [
    "vanadium.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-language-kotlin": ">=1.14.2+kotlin.2.4.21",
    "fabric-api": ">=0.165.2",
    "minecraft": "26.3",
    "java": ">=25",
    "cloth-config2": ">=26.3.159",
    "c2me": ">=0.4.2-alpha.0.116"
  },
  "suggests": {},
  "breaks": {
    "lithium": "*",
    "vmp": "*"
  }
}
