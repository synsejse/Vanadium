---
import { getEntry, render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import { mdxComponents } from '../components/mdx';
import { labs } from '../components/labs';
import TickTimeline from '../components/labs/TickTimeline.astro';

const page = await getEntry('docs', 'overview');
if (!page) throw new Error('src/content/docs/overview.mdx is missing');
const { Content, headings } = await render(page);
---

<DocLayout id={page.id} {...page.data} headings={headings} hero>
  <TickTimeline slot="hero" />
  <Content components={{ ...mdxComponents, ...labs }} />
</DocLayout>
